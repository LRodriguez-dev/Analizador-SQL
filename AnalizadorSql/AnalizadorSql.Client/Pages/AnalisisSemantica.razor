
@page "/analisis-semantica"
@rendermode InteractiveWebAssembly

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using AnalizadorSql.Client.Services
@inject HttpClient Http

<PageTitle>Análisis con semántica</PageTitle>

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <h2 class="fw-bold">Análisis con semántica</h2>
        <p class="text-muted">
            Analiza scripts SQL Server y simula los cambios en una base de datos en memoria.
            El esquema solo se actualiza si todas las validaciones pasan.
        </p>
    </div>

    <!-- EDITOR SQL -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Editor de código SQL</h5>
        </div>

        <div class="card-body">

            <label class="form-label fw-semibold">
                Cargar archivo SQL
            </label>

            <InputFile OnChange="CargarArchivo"
                       accept=".sql"
                       class="form-control mb-3" />

            <label class="form-label fw-semibold">
                Código SQL
            </label>

            <textarea class="form-control editor-sql"
                      style="height:260px;
                             min-height:150px;
                             max-height:450px;
                             overflow:auto;
                             resize:vertical;
                             font-family:Consolas,monospace;"
                      @bind="codigoSql"
                      placeholder="Escribe o pega tu código SQL aquí..."></textarea>

            <div class="d-flex gap-2 mt-3">

                <button class="btn btn-primary"
                        @onclick="AnalizarCodigo"
                        disabled="@analizando">
                    @(analizando ? "Analizando..." : "Analizar SQL")
                </button>

                <button class="btn btn-outline-secondary"
                        @onclick="LimpiarTodo"
                        disabled="@analizando">
                    Limpiar
                </button>

            </div>
        </div>
    </div>

    <!-- ERRORES DE CONEXIÓN -->
    @if (!string.IsNullOrEmpty(errorConexion))
    {
        <div class="alert alert-danger mb-4">
            @errorConexion
        </div>
    }

    @if (resultado != null)
    {
        <!-- RESUMEN -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Resumen del análisis</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-4">
                        <div class="resumen-item border rounded p-3">
                            <span class="text-muted">
                                Tokens identificados
                            </span>
                            <h3 class="mb-0">
                                @resultado.Tokens.Count
                            </h3>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="resumen-item border rounded p-3">
                            <span class="text-muted">
                                Errores encontrados
                            </span>
                            <h3 class="mb-0">
                                @resultado.Errores.Count
                            </h3>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="resumen-item border rounded p-3">
                            <span class="text-muted">
                                Estado del análisis
                            </span>

                            <div class="mt-2">
                                @if (resultado.EsValido)
                                {
                                    <span class="badge bg-success">
                                        Sintaxis válida
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Errores detectados
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- RESULTADOS LÉXICOS Y SINTÁCTICOS -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light
                        d-flex justify-content-between
                        align-items-center">

                <h5 class="mb-0">
                    Resultados de errores léxicos y sintácticos
                </h5>

                <span class="badge bg-secondary">
                    @resultado.Errores.Count errores
                </span>
            </div>

            <div class="card-body">

                @if (resultado.EsValido)
                {
                    <div class="alert alert-success mb-0">
                        El análisis finalizó correctamente.
                        No se detectaron errores léxicos
                        ni sintácticos.
                    </div>
                }
                else
                {
                    <!-- SCROLL INDEPENDIENTE DE ERRORES -->
                    <div class="tabla-scroll tabla-errores"
                         style="display:block;
                                width:100%;
                                height:230px;
                                max-height:230px;
                                overflow-y:auto;
                                overflow-x:auto;
                                border:1px solid #dee2e6;
                                border-radius:6px;">

                        <table class="table table-striped
                                      table-bordered table-hover
                                      mb-0 tabla-resultados"
                               style="min-width:650px;
                                      border-collapse:separate;
                                      border-spacing:0;">

                            <thead class="table-dark">
                                <tr>
                                    <th style="position:sticky;
                                               top:0;
                                               z-index:2;
                                               background:#212529;
                                               color:white;">
                                        Tipo
                                    </th>
                                    <th style="position:sticky;
                                               top:0;
                                               z-index:2;
                                               background:#212529;
                                               color:white;">
                                        Línea
                                    </th>
                                    <th style="position:sticky;
                                               top:0;
                                               z-index:2;
                                               background:#212529;
                                               color:white;">
                                        Columna
                                    </th>
                                    <th style="position:sticky;
                                               top:0;
                                               z-index:2;
                                               background:#212529;
                                               color:white;">
                                        Descripción del error
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var error in resultado.Errores)
                                {
                                    <tr>
                                        <td>@error.Tipo</td>
                                        <td>@error.Linea</td>
                                        <td>@error.Columna</td>
                                        <td class="text-danger">
                                            @error.Mensaje
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                    <small class="text-muted d-block mt-2">
                        Desplázate dentro de la tabla para
                        consultar todos los errores encontrados.
                    </small>
                }

            </div>
        </div>

        <!-- RESULTADOS DE TOKENS -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light
                        d-flex justify-content-between
                        align-items-center">

                <h5 class="mb-0">
                    Análisis léxico - Tokens
                </h5>

                <span class="badge bg-primary">
                    @resultado.Tokens.Count tokens
                </span>
            </div>

            <div class="card-body">

                <!-- SCROLL INDEPENDIENTE DE TOKENS -->
                <div class="tabla-scroll"
                     style="display:block;
                            width:100%;
                            height:350px;
                            max-height:350px;
                            overflow-y:auto;
                            overflow-x:auto;
                            border:1px solid #dee2e6;
                            border-radius:6px;">

                    <table class="table table-striped
                                  table-hover table-bordered
                                  mb-0 tabla-resultados"
                           style="min-width:650px;
                                  border-collapse:separate;
                                  border-spacing:0;">

                        <thead class="table-dark">
                            <tr>
                                <th style="position:sticky;
                                           top:0;
                                           z-index:2;
                                           background:#212529;
                                           color:white;">
                                    Tipo de token
                                </th>
                                <th style="position:sticky;
                                           top:0;
                                           z-index:2;
                                           background:#212529;
                                           color:white;">
                                    Lexema
                                </th>
                                <th style="position:sticky;
                                           top:0;
                                           z-index:2;
                                           background:#212529;
                                           color:white;">
                                    Línea
                                </th>
                                <th style="position:sticky;
                                           top:0;
                                           z-index:2;
                                           background:#212529;
                                           color:white;">
                                    Columna
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var token in resultado.Tokens)
                            {
                                <tr>
                                    <td>@token.Tipo</td>

                                    <td>
                                        <code class="lexema">@token.Texto</code>
                                    </td>

                                    <td>@token.Linea</td>
                                    <td>@token.Columna</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                <small class="text-muted d-block mt-2">
                    Utiliza la barra de desplazamiento
                    para consultar todos los tokens identificados.
                </small>

            </div>
        </div>
    }

    <!-- RESULTADOS SEMÁNTICOS Y ESQUEMA SIMULADO -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="mb-0">Esquema de la base de datos simulada</h5>
                <small class="text-muted">Estado en memoria de las bases de datos, tablas, columnas y registros.</small>
            </div>
            <button class="btn btn-outline-danger btn-sm"
                    @onclick="RestablecerEsquema"
                    disabled="@analizando">
                Restablecer esquema
            </button>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(estadoSemantico))
            {
                <div class="alert @(erroresSemanticos.Count > 0 || (resultado != null && !resultado.EsValido) ? "alert-danger" : "alert-info")">
                    @estadoSemantico
                </div>
            }

            @if (resultado != null && !resultado.EsValido)
            {
                <div class="alert alert-warning">
                    La simulación no se ejecutó porque el script contiene errores léxicos o sintácticos. El esquema se conserva sin cambios.
                </div>
            }

            @if (erroresSemanticos.Count > 0)
            {
                <h6 class="fw-bold text-danger">Errores semánticos</h6>
                <div style="display:block;width:100%;max-height:230px;overflow:auto;border:1px solid #dee2e6;border-radius:6px;">
                    <table class="table table-striped table-bordered table-hover mb-0" style="min-width:650px;">
                        <thead class="table-dark" style="position:sticky;top:0;z-index:2;">
                            <tr><th>Línea</th><th>Columna</th><th>Descripción</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var error in erroresSemanticos)
                            {
                                <tr><td>@error.Linea</td><td>@error.Columna</td><td class="text-danger">@error.Mensaje</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <small class="text-muted d-block mt-2">Se descartaron todos los cambios de este script para evitar una actualización parcial del esquema.</small>
            }

            @if (operacionesSimuladas.Count > 0)
            {
                <h6 class="fw-bold mt-3">Operaciones del último script válido</h6>
                <div class="operaciones-scroll mb-3">
                    <ul class="list-group list-group-flush">
                        @foreach (var operacion in operacionesSimuladas)
                        {
                            <li class="list-group-item">@operacion</li>
                        }
                    </ul>
                </div>
            }

            <div class="row g-3 mb-3">
                <div class="col-md-4"><div class="border rounded p-3 h-100"><small class="text-muted">Bases de datos</small><h4 class="mb-0">@esquema.BasesDatos.Count</h4></div></div>
                <div class="col-md-4"><div class="border rounded p-3 h-100"><small class="text-muted">Tablas</small><h4 class="mb-0">@esquema.BasesDatos.Sum(b => b.Tablas.Count)</h4></div></div>
                <div class="col-md-4"><div class="border rounded p-3 h-100"><small class="text-muted">Registros simulados</small><h4 class="mb-0">@esquema.BasesDatos.Sum(b => b.Tablas.Sum(t => t.Registros.Count))</h4></div></div>
            </div>

            @if (esquema.BasesDatos.Count == 0)
            {
                <div class="text-center text-muted border rounded p-4">
                    <h6>El esquema está vacío</h6>
                    <p class="mb-0">Analiza un script válido que cree una base de datos, tablas y registros para comenzar a construir el esquema simulado.</p>
                </div>
            }
            else
            {
                @foreach (var baseDatos in esquema.BasesDatos)
                {
                    <details class="border rounded mb-3" open>
                        <summary class="bg-light p-3 fw-bold" style="cursor:pointer;">
                            Base de datos: @baseDatos.Nombre
                            <span class="badge bg-secondary ms-2">@baseDatos.Tablas.Count tablas</span>
                            @if (string.Equals(esquema.BaseDatosActual, baseDatos.Nombre, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success ms-1">En uso</span>
                            }
                        </summary>
                        <div class="p-3">
                            @if (baseDatos.Tablas.Count == 0)
                            {
                                <p class="text-muted mb-0">Esta base de datos todavía no contiene tablas.</p>
                            }
                            @foreach (var tabla in baseDatos.Tablas)
                            {
                                <div class="border rounded mb-3">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-2 bg-light">
                                        <strong>Tabla: @tabla.Esquema.@tabla.Nombre</strong>
                                        <span class="badge bg-primary">@tabla.Registros.Count registros</span>
                                    </div>
                                    <div class="p-2">
                                        <h6>Columnas</h6>
                                        <div style="display:block;width:100%;max-height:180px;overflow:auto;border:1px solid #dee2e6;border-radius:5px;">
                                            <table class="table table-sm table-bordered table-striped mb-0" style="min-width:450px;">
                                                <thead class="table-dark"><tr><th>#</th><th>Nombre</th><th>Tipo de dato</th></tr></thead>
                                                <tbody>
                                                    @for (int i = 0; i < tabla.Columnas.Count; i++)
                                                    {
                                                        <tr><td>@(i + 1)</td><td>@tabla.Columnas[i].Nombre</td><td>@tabla.Columnas[i].Tipo @(tabla.Columnas[i].EsIdentity ? "IDENTITY" : "")</td></tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <h6 class="mt-3">Registros</h6>
                                        @if (tabla.Registros.Count == 0)
                                        {
                                            <p class="text-muted mb-1">No hay registros insertados.</p>
                                        }
                                        else
                                        {
                                            <div class="registros-scroll">
                                                <table class="table table-sm table-striped table-bordered mb-0 registros-tabla" style="min-width:650px;">
                                                    <thead class="table-dark" style="position:sticky;top:0;z-index:2;">
                                                        <tr>
                                                            <th>#</th>
                                                            @foreach (var columna in tabla.Columnas)
                                                            {
                                                                <th>@columna.Nombre</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int fila = 0; fila < tabla.Registros.Count; fila++)
                                                        {
                                                            <tr>
                                                                <td>@(fila + 1)</td>
                                                                @foreach (var valor in tabla.Registros[fila])
                                                                {
                                                                    <td>@valor</td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </details>
                }
            }
            <small class="text-muted">Este esquema es temporal y existe solo en memoria. Al actualizar la página se reinicia; no se ejecutan cambios en un SQL Server real.</small>
        </div>
    </div>
</div>

<style>
    /* Scroll de operaciones: se activa solo cuando supera el alto máximo. */
    .operaciones-scroll {
        width: 100%;
        max-height: 260px;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
        border-radius: 6px;
    }

    /* Cabecera + 5 filas de 36px: la sexta queda fuera y aparece el scroll. */
    .registros-scroll {
        display: block;
        width: 100%;
        max-height: 216px;
        overflow: auto;
        border: 1px solid #dee2e6;
        border-radius: 5px;
    }

    .registros-tabla th,
    .registros-tabla td {
        height: 36px;
        box-sizing: border-box;
        vertical-align: middle;
        white-space: nowrap;
    }

    .registros-tabla thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background-color: #212529;
        color: white;
    }
</style>

@code {

    private string codigoSql = "";
    private bool analizando = false;
    private string errorConexion = "";
    private ResultadoAnalisisDto? resultado;
    private EsquemaSimulado esquema = new();
    private List<ErrorSemanticoSimulado> erroresSemanticos = new();
    private List<string> operacionesSimuladas = new();
    private string estadoSemantico = "El esquema está vacío. La simulación se ejecutará después de un análisis léxico y sintáctico válido.";

    // CARGAR ARCHIVO SQL
    private async Task CargarArchivo(InputFileChangeEventArgs e)
    {
        resultado = null;
        errorConexion = "";

        try
        {
            var archivo = e.File;

            if (!archivo.Name.EndsWith(
                ".sql",
                StringComparison.OrdinalIgnoreCase))
            {
                errorConexion = "Selecciona un archivo .sql";
                return;
            }

            using var stream = archivo.OpenReadStream(
                maxAllowedSize: 2 * 1024 * 1024);

            using var reader = new StreamReader(stream);

            codigoSql = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            errorConexion =
                $"No se pudo leer el archivo: {ex.Message}";
        }
    }

    // ANALIZAR CÓDIGO SQL
    private async Task AnalizarCodigo()
    {
        resultado = null;
        errorConexion = "";

        if (string.IsNullOrWhiteSpace(codigoSql))
        {
            errorConexion = "Ingresa código SQL para analizar.";
            return;
        }

        analizando = true;

        try
        {
            var solicitud = new
            {
                Codigo = codigoSql
            };

            var respuesta = await Http.PostAsJsonAsync(
                "api/analizar",
                solicitud
            );

            respuesta.EnsureSuccessStatusCode();

            resultado = await respuesta.Content
                .ReadFromJsonAsync<ResultadoAnalisisDto>();

            erroresSemanticos = new();
            operacionesSimuladas = new();

            if (resultado == null)
            {
                estadoSemantico = "No se recibió un resultado del analizador.";
                return;
            }

            if (!resultado.EsValido)
            {
                estadoSemantico = "Simulación bloqueada: corrige primero todos los errores léxicos y sintácticos.";
                return;
            }

            var simulacion = new SimuladorSql().Simular(codigoSql, esquema);
            erroresSemanticos = simulacion.Errores;

            if (simulacion.Exitoso)
            {
                esquema = simulacion.Esquema;
                operacionesSimuladas = simulacion.Operaciones;
                estadoSemantico = "Análisis semántico correcto. Todos los cambios simulados se aplicaron al esquema.";
            }
            else
            {
                estadoSemantico = "Se detectaron errores semánticos. No se aplicó ningún cambio del script al esquema.";
            }
        }
        catch (Exception ex)
        {
            errorConexion =
                $"Error al analizar: {ex.Message}";
        }
        finally
        {
            analizando = false;
        }
    }

    // LIMPIAR EDITOR Y RESULTADOS
    private void LimpiarTodo()
    {
        codigoSql = "";
        resultado = null;
        errorConexion = "";
    }

    private void RestablecerEsquema()
    {
        esquema = new EsquemaSimulado();
        erroresSemanticos = new();
        operacionesSimuladas = new();
        estadoSemantico = "Esquema restablecido. La base de datos simulada está vacía.";
    }

    // MODELOS DE RESULTADOS
    public class ResultadoAnalisisDto
    {
        public bool EsValido { get; set; }

        public List<TokenSqlDto> Tokens { get; set; } = new();

        public List<ErrorSqlDto> Errores { get; set; } = new();

        public List<ErrorSqlDto> ErroresLexicos { get; set; } = new();

        public List<ErrorSqlDto> ErroresSintacticos { get; set; } = new();
    }

    public class TokenSqlDto
    {
        public string Tipo { get; set; } = "";
        public string Texto { get; set; } = "";
        public int Linea { get; set; }
        public int Columna { get; set; }
    }

    public class ErrorSqlDto
    {
        public string Tipo { get; set; } = "";
        public int Linea { get; set; }
        public int Columna { get; set; }
        public string Mensaje { get; set; } = "";
    }
}
