@page "/"
@page "/analizar"
@rendermode InteractiveWebAssembly

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http

<PageTitle>Analizador SQL Server</PageTitle>

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <h2 class="fw-bold">Analizador SQL Server</h2>
        <p class="text-muted">
            Herramienta para realizar análisis léxico y sintáctico
            de scripts SQL Server.
        </p>
    </div>

    <!-- EDITOR SQL -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Editor de código SQL</h5>
        </div>

        <div class="card-body">

            <label class="form-label fw-semibold">
                Cargar archivo SQL
            </label>

            <InputFile OnChange="CargarArchivo"
                       accept=".sql"
                       class="form-control mb-3" />

            <label class="form-label fw-semibold">
                Código SQL
            </label>

            <textarea class="form-control editor-sql"
                      style="height:260px;
                             min-height:150px;
                             max-height:450px;
                             overflow:auto;
                             resize:vertical;
                             font-family:Consolas,monospace;"
                      @bind="codigoSql"
                      placeholder="Escribe o pega tu código SQL aquí..."></textarea>

            <div class="d-flex gap-2 mt-3">

                <button class="btn btn-primary"
                        @onclick="AnalizarCodigo"
                        disabled="@analizando">
                    @(analizando ? "Analizando..." : "Analizar SQL")
                </button>

                <button class="btn btn-outline-secondary"
                        @onclick="LimpiarTodo"
                        disabled="@analizando">
                    Limpiar
                </button>

            </div>
        </div>
    </div>

    <!-- ERRORES DE CONEXIÓN -->
    @if (!string.IsNullOrEmpty(errorConexion))
    {
        <div class="alert alert-danger mb-4">
            @errorConexion
        </div>
    }

    @if (resultado != null)
    {
        <!-- RESUMEN -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Resumen del análisis</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-4">
                        <div class="resumen-item border rounded p-3">
                            <span class="text-muted">
                                Tokens identificados
                            </span>
                            <h3 class="mb-0">
                                @resultado.Tokens.Count
                            </h3>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="resumen-item border rounded p-3">
                            <span class="text-muted">
                                Errores encontrados
                            </span>
                            <h3 class="mb-0">
                                @resultado.Errores.Count
                            </h3>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="resumen-item border rounded p-3">
                            <span class="text-muted">
                                Estado del análisis
                            </span>

                            <div class="mt-2">
                                @if (resultado.EsValido)
                                {
                                    <span class="badge bg-success">
                                        Sintaxis válida
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Errores detectados
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- RESULTADOS LÉXICOS Y SINTÁCTICOS -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light
                        d-flex justify-content-between
                        align-items-center">

                <h5 class="mb-0">
                    Resultados de errores léxicos y sintácticos
                </h5>

                <span class="badge bg-secondary">
                    @resultado.Errores.Count errores
                </span>
            </div>

            <div class="card-body">

                @if (resultado.EsValido)
                {
                    <div class="alert alert-success mb-0">
                        El análisis finalizó correctamente.
                        No se detectaron errores léxicos
                        ni sintácticos.
                    </div>
                }
                else
                {
                    <!-- SCROLL INDEPENDIENTE DE ERRORES -->
                    <div class="tabla-scroll tabla-errores"
                         style="display:block;
                                width:100%;
                                height:230px;
                                max-height:230px;
                                overflow-y:auto;
                                overflow-x:auto;
                                border:1px solid #dee2e6;
                                border-radius:6px;">

                        <table class="table table-striped
                                      table-bordered table-hover
                                      mb-0 tabla-resultados"
                               style="min-width:650px;
                                      border-collapse:separate;
                                      border-spacing:0;">

                            <thead class="table-dark">
                                <tr>
                                    <th style="position:sticky;
                                               top:0;
                                               z-index:2;
                                               background:#212529;
                                               color:white;">
                                        Tipo
                                    </th>
                                    <th style="position:sticky;
                                               top:0;
                                               z-index:2;
                                               background:#212529;
                                               color:white;">
                                        Línea
                                    </th>
                                    <th style="position:sticky;
                                               top:0;
                                               z-index:2;
                                               background:#212529;
                                               color:white;">
                                        Columna
                                    </th>
                                    <th style="position:sticky;
                                               top:0;
                                               z-index:2;
                                               background:#212529;
                                               color:white;">
                                        Descripción del error
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var error in resultado.Errores)
                                {
                                    <tr>
                                        <td>@error.Tipo</td>
                                        <td>@error.Linea</td>
                                        <td>@error.Columna</td>
                                        <td class="text-danger">
                                            @error.Mensaje
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                    <small class="text-muted d-block mt-2">
                        Desplázate dentro de la tabla para
                        consultar todos los errores encontrados.
                    </small>
                }

            </div>
        </div>

        <!-- RESULTADOS DE TOKENS -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-light
                        d-flex justify-content-between
                        align-items-center">

                <h5 class="mb-0">
                    Análisis léxico - Tokens
                </h5>

                <span class="badge bg-primary">
                    @resultado.Tokens.Count tokens
                </span>
            </div>

            <div class="card-body">

                <!-- SCROLL INDEPENDIENTE DE TOKENS -->
                <div class="tabla-scroll"
                     style="display:block;
                            width:100%;
                            height:350px;
                            max-height:350px;
                            overflow-y:auto;
                            overflow-x:auto;
                            border:1px solid #dee2e6;
                            border-radius:6px;">

                    <table class="table table-striped
                                  table-hover table-bordered
                                  mb-0 tabla-resultados"
                           style="min-width:650px;
                                  border-collapse:separate;
                                  border-spacing:0;">

                        <thead class="table-dark">
                            <tr>
                                <th style="position:sticky;
                                           top:0;
                                           z-index:2;
                                           background:#212529;
                                           color:white;">
                                    Tipo de token
                                </th>
                                <th style="position:sticky;
                                           top:0;
                                           z-index:2;
                                           background:#212529;
                                           color:white;">
                                    Lexema
                                </th>
                                <th style="position:sticky;
                                           top:0;
                                           z-index:2;
                                           background:#212529;
                                           color:white;">
                                    Línea
                                </th>
                                <th style="position:sticky;
                                           top:0;
                                           z-index:2;
                                           background:#212529;
                                           color:white;">
                                    Columna
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var token in resultado.Tokens)
                            {
                                <tr>
                                    <td>@token.Tipo</td>

                                    <td>
                                        <code class="lexema">@token.Texto</code>
                                    </td>

                                    <td>@token.Linea</td>
                                    <td>@token.Columna</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                <small class="text-muted d-block mt-2">
                    Utiliza la barra de desplazamiento
                    para consultar todos los tokens identificados.
                </small>

            </div>
        </div>
    }
</div>

@code {

    private string codigoSql = "";
    private bool analizando = false;
    private string errorConexion = "";
    private ResultadoAnalisisDto? resultado;

    // CARGAR ARCHIVO SQL
    private async Task CargarArchivo(InputFileChangeEventArgs e)
    {
        resultado = null;
        errorConexion = "";

        try
        {
            var archivo = e.File;

            if (!archivo.Name.EndsWith(
                ".sql",
                StringComparison.OrdinalIgnoreCase))
            {
                errorConexion = "Selecciona un archivo .sql";
                return;
            }

            using var stream = archivo.OpenReadStream(
                maxAllowedSize: 2 * 1024 * 1024);

            using var reader = new StreamReader(stream);

            codigoSql = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            errorConexion =
                $"No se pudo leer el archivo: {ex.Message}";
        }
    }

    // ANALIZAR CÓDIGO SQL
    private async Task AnalizarCodigo()
    {
        resultado = null;
        errorConexion = "";

        if (string.IsNullOrWhiteSpace(codigoSql))
        {
            errorConexion = "Ingresa código SQL para analizar.";
            return;
        }

        analizando = true;

        try
        {
            var solicitud = new
            {
                Codigo = codigoSql
            };

            var respuesta = await Http.PostAsJsonAsync(
                "api/analizar",
                solicitud
            );

            respuesta.EnsureSuccessStatusCode();

            resultado = await respuesta.Content
                .ReadFromJsonAsync<ResultadoAnalisisDto>();
        }
        catch (Exception ex)
        {
            errorConexion =
                $"Error al analizar: {ex.Message}";
        }
        finally
        {
            analizando = false;
        }
    }

    // LIMPIAR EDITOR Y RESULTADOS
    private void LimpiarTodo()
    {
        codigoSql = "";
        resultado = null;
        errorConexion = "";
    }

    // MODELOS DE RESULTADOS
    public class ResultadoAnalisisDto
    {
        public bool EsValido { get; set; }

        public List<TokenSqlDto> Tokens { get; set; } = new();

        public List<ErrorSqlDto> Errores { get; set; } = new();

        public List<ErrorSqlDto> ErroresLexicos { get; set; } = new();

        public List<ErrorSqlDto> ErroresSintacticos { get; set; } = new();
    }

    public class TokenSqlDto
    {
        public string Tipo { get; set; } = "";
        public string Texto { get; set; } = "";
        public int Linea { get; set; }
        public int Columna { get; set; }
    }

    public class ErrorSqlDto
    {
        public string Tipo { get; set; } = "";
        public int Linea { get; set; }
        public int Columna { get; set; }
        public string Mensaje { get; set; } = "";
    }
}
